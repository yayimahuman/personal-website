{
	"name": "harrytong",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-01",
	"routes": [
		{"pattern": "harrytong.com", "custom_domain": true},
		{"pattern": "www.harrytong.com", "custom_domain": true}
	],
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		// React Router handles all non-file paths
		"not_found_handling": "single-page-application",
		// Only these hit the Worker; everything else is served straight from assets
		"run_worker_first": ["/files/*", "/resume.pdf", "/path", "/path/*"]
	},
	// Private files served by the Worker (kept out of this public repo). Update the resume with:
	//   npx wrangler r2 object put harrytong-files/resume.pdf --file <path> --content-type application/pdf --remote
	// Withdraw it with:
	//   npx wrangler r2 object delete harrytong-files/resume.pdf --remote
	"r2_buckets": [{"binding": "FILES", "bucket_name": "harrytong-files"}],
	"observability": {
		"enabled": true
	}
}
